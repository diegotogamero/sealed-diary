{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sealed Diary",
  "version": "0.1.0",
  "identifier": "io.github.diegotogamero.sealeddiary",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sealed Diary",
        "width": 1040,
        "height": 720,
        "minWidth": 340,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' media: http://media.localhost; media-src 'self' media: http://media.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
